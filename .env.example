# Copy to .env (make up does it the first time). Every value here is a throwaway for a database that lives
# on this machine while its container runs; change them if you share the machine. No real secret belongs in this file.

# PostgreSQL container (the owner role runs the DDL; the app connects as the limited role).
POSTGRES_USER=notes_owner
POSTGRES_PASSWORD=local-only-owner-password
POSTGRES_DB=notes
POSTGRES_PORT=5471

# The application.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8047
LOG_LEVEL=INFO
TRUSTED_PROXY_COUNT=0

# The application's database role (least privilege: no DDL, append-only audit table).
NOTES_DB_HOST=localhost
NOTES_DB_PORT=5471
NOTES_DB_NAME=notes
NOTES_DB_USER=notes_app
NOTES_DB_PASSWORD=local-only-app-password
NOTES_DB_POOL_MIN=1
NOTES_DB_POOL_MAX=8

# Password hashing (argon2id; the floor is the OWASP minimum of 19 MiB, 2 iterations, 1 lane).
ARGON2_TIME_COST=2
ARGON2_MEMORY_KIB=19456
ARGON2_PARALLELISM=1

# Sessions and login throttling.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
ANONYMOUS_SESSION_SECONDS=900
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Deliberate weaknesses, one per control. They exist so the tests can prove each control by watching it fail
# without it. They are refused unless APP_ENV=test, and they default to off. Leave them unset.
# UNSAFE_WEAK_PASSWORD_HASH=1
# UNSAFE_SQL_CONCATENATION=1
# UNSAFE_RAW_NOTE_OUTPUT=1
# UNSAFE_SKIP_OWNERSHIP_CHECK=1
# UNSAFE_WEAK_SESSION_COOKIE=1
# UNSAFE_SKIP_CSRF=1
# UNSAFE_SKIP_SECURITY_HEADERS=1
